# Copy to server/.env (never commit it). Read by `npm run server` and the Docker image.
PORT=8787
# Opens /report.html and /deaths: a long random string, e.g. from `node -e "console.log(crypto.randomUUID())"`
ADMIN_TOKEN=
# Sites allowed to call the server, comma separated; * — any (fine while testing)
ALLOWED_ORIGINS=*
# Where events, scores, saves and replays are kept (default server/data)
DATA_DIR=
