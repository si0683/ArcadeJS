{
  "name": "my-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "zip": "npm run build && node scripts/zip.mjs",
    "atlas": "node scripts/atlas.mjs",
    "size": "node scripts/size.mjs",
    "build:web": "npm run build && node scripts/pwa.mjs",
    "audio": "node scripts/audio.mjs",
    "test:perf": "playwright test --project=perf",
    "i18n:export": "node scripts/i18n.mjs export",
    "i18n:import": "node scripts/i18n.mjs import",
    "sentry:sourcemaps": "node scripts/sentry.mjs",
    "server": "node server/index.mjs",
    "portal": "npm run build && node scripts/portal-check.mjs && playwright test e2e/portal.spec.ts --project=chromium",
    "mobile:init": "node scripts/mobile.mjs init",
    "mobile": "node scripts/mobile.mjs open",
    "desktop:init": "npm i -D electron@^45 electron-builder@^26",
    "desktop": "npm run build && electron .",
    "desktop:check": "npm run build && electron . --smoke",
    "desktop:build": "npm run build && electron-builder --config desktop/electron-builder.json",
    "audio:sprite": "node scripts/audio-sprite.mjs",
    "art": "node scripts/aseprite.mjs",
    "test:golden": "playwright test e2e/golden.spec.ts --project=chromium",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "maxrects-packer": "^3.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tweakpane": "^4.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
