# Copy to .env and fill in what you use; empty — the service is off. Everything with VITE_ goes into
# the public game build: only public keys here (no passwords, no secret tokens).

# Error reports: sentry.io or GlitchTip → project → Client Keys (DSN). Source maps: npm run sentry:sourcemaps
VITE_SENTRY_DSN=
# Yandex Metrica counter number (metrica.yandex.ru): game events become goals
VITE_METRICA_ID=
# The game server (server/README.md): analytics with funnels and retention, leaderboard, cloud save
VITE_BACKEND_URL=
